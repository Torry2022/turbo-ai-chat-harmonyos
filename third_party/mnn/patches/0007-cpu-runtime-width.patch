+int Llm::cpu_thread_count() const {
+    if (!mExecutor) return 0;
+    Express::ExecutorScope scope(mExecutor);
+    const auto runtimes = Express::Executor::getRuntime();
+    auto entry = runtimes.first.find(MNN_FORWARD_CPU);
+    const auto runtime = entry == runtimes.first.end() ? runtimes.second : entry->second;
+    if (!runtime) return 0;
+    Backend::Info info{};
+    info.type = MNN_FORWARD_CPU;
+    info.numThread = 0;
+    return runtime->onCheckInfo(info) ? info.numThread : 0;
+}
